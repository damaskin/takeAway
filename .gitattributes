* text=auto eol=lf

# Shell scripts are written on Windows and executed on Linux. A CRLF shebang
# fails with `bad interpreter: /usr/bin/env bash^M`, which on a deploy script
# means the deploy dies at its first line for a reason that is invisible in a
# diff. Same for the nginx configs and env templates the scripts source.
*.sh          text eol=lf
*.bash        text eol=lf
*.conf        text eol=lf
.env.example  text eol=lf
*.example     text eol=lf
Dockerfile*   text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.pdf  binary
