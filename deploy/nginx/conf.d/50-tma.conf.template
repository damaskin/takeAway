server {
  listen 443 ssl;
  http2 on;
  server_name {{TMA_HOST}};

  ssl_certificate     /etc/letsencrypt/live/{{TLS_CERT_NAME}}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{TLS_CERT_NAME}}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  # Security headers (snippets/security-headers.conf). The Mini App must stay
  # embeddable: Telegram Web (web.telegram.org and its K/A variants) shows it
  # in an iframe, so there is no X-Frame-Options here. frame-ancestors allows
  # exactly Telegram's sites instead of anyone. The phone and desktop clients
  # open it as a top-level web view, where frame-ancestors does not apply.
  set $frame_options "";
  set $csp "frame-ancestors 'self' https://*.telegram.org; base-uri 'self'; object-src 'none'";
  set $csp_report_only "";
  set $permissions_policy "geolocation=(self), camera=(), microphone=()";
  include /etc/nginx/snippets/security-headers.conf;

  include /etc/nginx/snippets/api-proxy.conf;

  set $spa_root /usr/share/nginx/html/tma;
  include /etc/nginx/snippets/spa.conf;
}
