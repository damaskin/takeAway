server {
  listen 443 ssl;
  http2 on;
  server_name {{DOMAIN_WEB}};

  ssl_certificate     /etc/letsencrypt/live/{{TLS_CERT_NAME}}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{TLS_CERT_NAME}}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  # Security headers (snippets/security-headers.conf). Nothing frames the
  # website: Google, Apple and Telegram sign-in open popups or put their own
  # frames inside our page. Checkout and the order screen ask for location.
  set $frame_options "DENY";
  set $csp "frame-ancestors 'none'; base-uri 'self'; object-src 'none'";
  set $csp_report_only "";
  set $permissions_policy "geolocation=(self), camera=(), microphone=()";
  include /etc/nginx/snippets/security-headers.conf;

  include /etc/nginx/snippets/api-proxy.conf;

  # Map tiles for every app — /tiles/{z}/{x}/{y}.png, cached OpenStreetMap.
  include /etc/nginx/snippets/tiles.conf;

  set $spa_root /usr/share/nginx/html/web;
  include /etc/nginx/snippets/spa.conf;
}
