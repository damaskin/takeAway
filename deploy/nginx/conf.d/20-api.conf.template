server {
  listen 443 ssl;
  http2 on;
  server_name {{DOMAIN_API}};

  ssl_certificate     /etc/letsencrypt/live/{{TLS_CERT_NAME}}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{TLS_CERT_NAME}}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  # JSON only — the API's own helmet headers cover the rest.
  set $frame_options "";
  set $csp "";
  set $csp_report_only "";
  set $permissions_policy "";
  include /etc/nginx/snippets/security-headers.conf;

  # The mobile apps talk to this host: /api/... for HTTP and /socket.io/ for
  # the realtime gateway, with the same limits as on the SPA hosts. The app
  # has a global 'api' prefix, so requests hit {{DOMAIN_API}}/api/... even
  # though the subdomain itself scopes everything — kept for continuity with
  # existing client base URLs.
  include /etc/nginx/snippets/api-proxy.conf;

  # Anything else is the API's 404 to give, under the general limit.
  location / {
    limit_req zone=api burst=40 nodelay;
    error_page 429 = @too_many_requests;
    include /etc/nginx/snippets/api-upstream.conf;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }
}
