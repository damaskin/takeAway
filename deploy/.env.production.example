# takeAway production environment — copy to deploy/.env.production and fill in.
# Never commit the filled-in file.

# -------- Required --------
POSTGRES_USER=takeaway
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_DB=takeaway

# 32+ byte random strings (openssl rand -hex 32). MUST differ between access & refresh.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# AES-256-GCM key for POS credentials at rest. deploy.sh refuses to run
# without it. Generate with: openssl rand -hex 32
POS_CREDENTIALS_KEY=CHANGE_ME

# HMAC key for KDS tablet PINs. Without it every PIN login is rejected —
# staff fall back to email + password. Generate with: openssl rand -hex 32
KDS_PIN_SECRET=CHANGE_ME

# -------- Recommended prod settings --------
NODE_ENV=production
LOG_LEVEL=info
API_GLOBAL_PREFIX=api

# Tighter OTP limits than dev defaults (already the prod defaults but pinned for clarity).
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SEND_PER_HOUR=5

THROTTLER_TTL_MS=60000
THROTTLER_LIMIT=100

# Delivery feature flag — off until you're ready to launch delivery.
DELIVERY_ENABLED=false

# Origins allowed to call the API from a browser, comma-separated. Leave it
# empty and the API reflects whatever origin asks, which means any page
# anywhere can call it in a signed-in browser's name. Set it.
CORS_ALLOWED_ORIGINS=https://takeaway.million-sales.ru,https://admin.takeaway.million-sales.ru,https://kds.takeaway.million-sales.ru,https://tma.takeaway.million-sales.ru

# Swagger is off in production unless this is exactly `true`. It maps every
# endpoint, DTO and auth requirement, so turn it on deliberately — useful
# while you are reviewing a release, worth turning back off afterwards.
SWAGGER_ENABLED=false

# How long an order may sit unpaid before it is released and its promo,
# gift-card balance and pickup slot all go back. Values under 5 are clamped.
ORDER_PAYMENT_TTL_MINUTES=15

# Loyalty points granted to both sides of a referral on the referee's first
# paid order. 0 soft-disables the programme without removing the UI.
REFERRAL_BONUS_POINTS=100

# -------- Optional / fill in later --------

# Telegram login widget + Mini App bot token (one bot). Leave empty to disable.
TELEGRAM_BOT_TOKEN=

# Public bot username (without @) — used to render the Login Widget on web.
TELEGRAM_BOT_USERNAME=

# Base URL of the admin app — used in password-reset email links.
ADMIN_APP_URL=https://admin.takeaway.million-sales.ru

# First super-admin bootstrap (seed).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Object storage for uploaded images (brand logos, product photos later).
# Default wires the bundled MinIO container (see docker-compose.prod.yml).
# Point at AWS/Backblaze/DO-Spaces by replacing these values — the app
# doesn't care which S3-compatible backend is behind the URL.
#
# S3_ACCESS_KEY defaults to 'minioadmin'; pick a strong S3_SECRET_KEY.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_STRONG_RANDOM
S3_BUCKET=takeaway-uploads
S3_PUBLIC_URL_BASE=https://cdn.takeaway.million-sales.ru/takeaway-uploads

# Optional: where to send MinIO console redirects (usually the CDN host).
MINIO_BROWSER_REDIRECT_URL=https://cdn.takeaway.million-sales.ru

# Stripe (not used yet — leave empty).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP for transactional mail (password reset, later receipts).
# Any SMTP provider works — Brevo / Resend / Mailgun / Postmark / your
# registrar's SMTP. Leave SMTP_HOST blank to keep MailService in log-only mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@takeaway.million-sales.ru

# -------- Social sign-in (customers) --------
# Comma-separated client ids the API accepts as the `aud` on an incoming ID
# token — one per platform. Empty disables that provider server-side.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=

# The public halves, injected into each SPA's index.html at deploy time by
# extract-spa.sh. These must also appear in the lists above or the server
# will reject the tokens they produce. Empty hides the button.
GOOGLE_OAUTH_WEB_CLIENT_ID=
# Apple *Services ID*, not the app bundle id.
APPLE_OAUTH_SERVICES_ID=
# Must match a Return URL registered against that Services ID.
APPLE_OAUTH_REDIRECT_URI=https://takeaway.million-sales.ru/login

# -------- Web push --------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@takeaway.million-sales.ru

# -------- Operations --------
# Telegram chat that receives operational alerts: a dependency down, paid
# orders the kitchen has not accepted for 10 minutes, a stalled analytics
# roll-up. Uses TELEGRAM_BOT_TOKEN above. Empty disables alerting.
OPS_ALERT_TELEGRAM_CHAT_ID=

# Passphrase for the nightly encrypted database backup. The backup script
# refuses to run without it, because the dump holds customer names, emails,
# phones and order history and its mirror repo keeps history forever.
# Generate with: openssl rand -base64 48
BACKUP_ENCRYPTION_KEY=

# SMS / maps / analytics / monitoring — wire in as products ship.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MAPBOX_TOKEN=
MIXPANEL_TOKEN=

# Sentry. SENTRY_DSN is the server project; SENTRY_DSN_WEB is the browser
# project, injected into every SPA's index.html at deploy time. A browser DSN
# is public by design. Leave either empty to disable that side.
SENTRY_DSN=
SENTRY_DSN_WEB=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
