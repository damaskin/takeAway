// takeAway — Prisma schema
// Conventions (see 02_CLAUDE_PROMPT.md §7):
//   - Money: integer cents, never floats. Column type: Int.
//   - Duration: integer seconds. Column type: Int.
//   - Timestamps: UTC, column type: DateTime. UI converts to store TZ.
//   - Currency: ISO 4217 code on Brand and persisted per Store.
//
// Scope of this migration: M1 (Auth + Catalog).
// Orders / Loyalty / Payments / GiftCards tables are added in later milestones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Locale {
  EN
  RU
}

enum Currency {
  USD
  EUR
  GBP
  AED
  THB
  IDR
  MDL
}

enum DeviceType {
  IOS
  ANDROID
  WEB
  TELEGRAM
}

enum OAuthProvider {
  GOOGLE
  APPLE
  TELEGRAM
}

enum Role {
  CUSTOMER
  STAFF
  STORE_MANAGER
  MENU_EDITOR
  BRAND_ADMIN
  SUPER_ADMIN
  RIDER
}

enum StoreStatus {
  OPEN
  CLOSED
  OVERLOADED
}

enum StoreFulfillment {
  TAKEAWAY
  DINE_IN
  DRIVE_THRU
  DELIVERY
}

enum PickupPointType {
  COUNTER
  LOCKER
  SHELF
}

enum VariationType {
  SIZE
  TEMPERATURE
  MILK
  CUP
}

enum DietTag {
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  LACTOSE_FREE
  DECAF
  SUGAR_FREE
}

enum FulfillmentType {
  PICKUP
  DINE_IN
  DELIVERY
}

enum PickupMode {
  ASAP
  SCHEDULED
}

enum OrderStatus {
  CREATED
  PAID
  ACCEPTED
  IN_PROGRESS
  READY
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  EXPIRED
}

enum OrderEventType {
  STATUS_CHANGED
  ETA_UPDATED
  CUSTOMER_NEARBY
  CUSTOMER_HERE
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  REFUND_ISSUED
  CANCELLED
  NOTE
}

enum PaymentProvider {
  STRIPE
  TELEGRAM
  APPLE_PAY
  GOOGLE_PAY
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// ─────────────────────────────────────────────────────────────────────────────
// Loyalty & Promo enums
// ─────────────────────────────────────────────────────────────────────────────

enum LoyaltyTier {
  SILVER
  GOLD
  PLATINUM
  SIGNATURE
}

/// Kind of movement in the points ledger.
/// EARN  — credited to the user (order paid, bonus, referral…)
/// SPEND — debited from the user (promo redemption, etc.)
/// EXPIRE — periodic cleanup of aged points (M3+)
/// ADJUST — manual admin correction (ticketed fix)
enum PointsEntryType {
  EARN
  SPEND
  EXPIRE
  ADJUST
}

enum PromoType {
  /// Percentage discount off subtotal (value = 0..100).
  PERCENT
  /// Flat discount in cents off subtotal.
  FIXED
  /// Cheapest qualifying item free (value = N of Y trigger; simplified M3).
  BOGO
  /// Multiply earned loyalty points by `value` (e.g. 2×).
  POINTS_MULTIPLIER
}

enum PromoStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  EXPIRED
}

/// Moderation state for a self-registered Brand.
///  * PENDING  — the owner can manage their catalog / stores, but nothing is
///               visible to customers until a SUPER_ADMIN approves.
///  * APPROVED — fully visible on the storefront.
///  * REJECTED — stays in the DB (with optional moderationNote) but is not
///               visible on the storefront and the owner can no longer add
///               new data.
enum BrandModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// POS integrations enums
// ─────────────────────────────────────────────────────────────────────────────

/// Supported back-office / POS providers a Brand can plug in. A new value
/// here is the entry point for adding a new IPosProvider implementation
/// (r-keeper, Frontpad, 1С, …).
enum PosProvider {
  IIKO
  POSTER
}

enum PosIntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

/// What a sync job intends to do. MENU / STOP_LIST / STORES are pulls from
/// the POS; ORDER_PUSH is a push of one order out to the POS.
enum PosSyncJobKind {
  MENU
  STOP_LIST
  STORES
  ORDER_PUSH
}

enum PosSyncJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  phone          String?   @unique
  email          String?   @unique
  /// bcrypt hash. Staff-only (SUPER_ADMIN / BRAND_ADMIN / STORE_MANAGER /
  /// STAFF / RIDER) — CUSTOMER users authenticate via Telegram and never
  /// set a password.
  passwordHash   String?
  /// Set to `true` when an admin invites the user with a temp password.
  /// The admin app routes a forced /change-password flow on login until
  /// the user rotates the hash, at which point this flips to `false`.
  passwordMustChange Boolean  @default(false)
  name           String?
  dateOfBirth    DateTime?
  avatarUrl      String?
  locale         Locale    @default(EN)
  currency       Currency  @default(USD)
  telegramUserId BigInt?   @unique
  role           Role      @default(CUSTOMER)
  /// Customer-facing push toggles. Staff push (new-order for a brand,
  /// rider-assigned) ignores these — it's operational, not promotional.
  notifyOrderUpdates Boolean @default(true)
  notifyPromotions   Boolean @default(true)
  blockedAt      DateTime?
  /// HMAC-SHA256 of (storeId + pin + KDS_PIN_SECRET). Staff sign in to the KDS
  /// app on a shared tablet by typing this short PIN on a per-store lockscreen.
  /// Scoped to one store at a time — staff working two stores get two PINs
  /// or use email+password instead. NULL when the user has no KDS access.
  kdsPinHash      String?
  kdsPinStoreId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  kdsPinStore         Store?               @relation("KdsPinStore", fields: [kdsPinStoreId], references: [id], onDelete: SetNull)
  devices             Device[]
  oauthAccounts       OAuthAccount[]
  passwordResetTokens PasswordResetToken[]
  ownedBrands         Brand[]              @relation("BrandOwner")
  carts               Cart[]
  orders              Order[]
  loyaltyAccount      LoyaltyAccount?
  pointsLedger        PointsLedger[]
  promoRedemptions    PromoRedemption[]
  // Multi-store scope for staff/rider roles. Empty for CUSTOMER; brand-admin
  // and super-admin bypass the pivot entirely (see UserStoreScopeService).
  userStores          UserStore[]
  // Delivery orders assigned to this user (RIDER). SetNull on delete so we
  // can remove riders without wiping the order history.
  assignedDeliveries  Order[]              @relation("RiderDeliveries")
  giftCardsPurchased  GiftCard[]           @relation("GiftCardsPurchased")

  // Referral program — every user gets a unique code lazily on first read.
  // referredByUserId points at the user whose code unlocked this account's
  // first-order bonus. Locked at the moment the apply endpoint fires; we
  // never overwrite it.
  referralCode        String?              @unique
  referredByUserId    String?
  referredBy          User?                @relation("ReferredBy", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referees            User[]               @relation("ReferredBy")
  referralsAsReferrer Referral[]           @relation("ReferralsAsReferrer")
  referralsAsReferee  Referral[]           @relation("ReferralsAsReferee")

  @@index([createdAt])
  @@index([referredByUserId])
}

/// Pairs a referrer with a referee and tracks whether the bonus has been
/// granted. Created the moment a customer applies a friend's code (status
/// PENDING). Flipped to REWARDED on the referee's first PAID order — at
/// which point both sides receive a points credit through PointsLedger.
model Referral {
  id                     String         @id @default(cuid())
  referrerId             String
  refereeId              String
  status                 ReferralStatus @default(PENDING)
  /// Order that triggered the reward. Null until status flips to REWARDED.
  rewardOrderId          String?
  refereePointsCredited  Int            @default(0)
  referrerPointsCredited Int            @default(0)
  createdAt              DateTime       @default(now())
  rewardedAt             DateTime?

  referrer User @relation("ReferralsAsReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralsAsReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([refereeId])
  @@index([referrerId, status])
}

enum ReferralStatus {
  PENDING
  REWARDED
  CANCELLED
}

model Device {
  id         String     @id @default(cuid())
  userId     String
  type       DeviceType
  pushToken  String?
  locale     Locale     @default(EN)
  lastSeenAt DateTime   @default(now())
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pushToken])
}

model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// One-shot email-based password reset token. Hashed (SHA-256) before
/// storage — the raw value is mailed to the user once and cannot be
/// recovered server-side.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy (brands, stores)
// ─────────────────────────────────────────────────────────────────────────────

model Brand {
  id               String                @id @default(cuid())
  slug             String                @unique
  name             String
  currency         Currency              @default(USD)
  locale           Locale                @default(EN)
  logoUrl          String?
  /// Optional CSS-variable overrides applied on top of the Telegram theme
  /// in TMA (and optionally web). Shape: `{ "--color-caramel": "#aabb00" }`.
  themeOverrides   Json?
  /// Null for the demo seed brand; set on every self-registered brand.
  ownerId          String?
  moderationStatus BrandModerationStatus @default(PENDING)
  /// Free-form note the super-admin can leave when rejecting or approving.
  moderationNote   String?
  submittedAt      DateTime              @default(now())
  moderatedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  owner           User?            @relation("BrandOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  stores          Store[]
  categories      Category[]
  products        Product[]
  promos          Promo[]
  posIntegrations PosIntegration[]
  giftCards       GiftCard[]
  campaigns       Campaign[]

  @@index([moderationStatus])
  @@index([ownerId])
}

/// Brand-driven outbound campaign. v1 is synchronous "send now" — admin
/// composes copy in the dashboard and the service fans out via push /
/// Telegram / email immediately. Counters are stamped after the fan-out
/// so the admin can see how many users we reached vs. opted out.
model Campaign {
  id           String           @id @default(cuid())
  brandId      String
  title        String
  body         String
  channel      CampaignChannel
  audience     CampaignAudience @default(ALL)
  status       CampaignStatus   @default(DRAFT)
  /// Target / sent / failed counters stamped during send.
  targetCount  Int              @default(0)
  sentCount    Int              @default(0)
  failedCount  Int              @default(0)
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, status])
  @@index([brandId, createdAt])
}

enum CampaignChannel {
  PUSH
  TELEGRAM
  EMAIL
}

enum CampaignAudience {
  /// Every customer in the brand's order history.
  ALL
  /// Customers who placed at least one paid order.
  HAS_ORDERED
  /// Customers whose last paid order is older than 30 days.
  INACTIVE_30D
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Store {
  id                    String             @id @default(cuid())
  brandId               String
  slug                  String             @unique
  name                  String
  addressLine           String
  city                  String
  country               String
  latitude              Float
  longitude             Float
  timezone              String             @default("UTC")
  currency              Currency
  phone                 String?
  email                 String?
  status                StoreStatus        @default(OPEN)
  fulfillmentTypes      StoreFulfillment[]
  pickupPointType       PickupPointType    @default(COUNTER)
  // 0..100 — higher means kitchen is busier.
  busyMeter             Int                @default(0)
  /// Fixed overhead on every order here, in seconds: ringing it up, plating,
  /// handover. This is NOT the ETA a customer sees — that is this value plus
  /// the live queue wait plus their own prep time. See KitchenLoadService.
  baseEtaSeconds        Int                @default(600)
  /// How many orders this kitchen genuinely works at once. Queue wait is
  /// outstanding work divided by this, so it is the one knob that decides
  /// how fast a morning rush drains.
  kitchenParallelism    Int                @default(2)
  /// Most orders this store will hand over inside one 15-minute slot. Once
  /// a slot is full it stops being offered at checkout, which is what keeps
  /// the ETA promise honest instead of just optimistic.
  slotCapacity          Int                @default(8)
  minOrderCents         Int                @default(0)
  /// Sales tax in basis points: 500 = 5% (UAE), 2000 = 20% (UK). 0 disables
  /// the tax line entirely. Per store, not per brand — a chain can straddle
  /// two countries.
  taxRateBps            Int                @default(0)
  /// True where the displayed menu price already contains the tax (UAE, UK,
  /// EU retail); false where it is added at the till (most of the US). This
  /// changes what the customer pays, not just what the receipt prints.
  taxIncludedInPrice    Boolean            @default(true)
  heroImageUrl          String?
  galleryUrls           String[]           @default([])
  // Per-store delivery fee overrides. All nullable — `null` means "inherit
  // the DELIVERY_FEE_* env defaults". Set on franchisees or high-density
  // stores that need their own economics.
  deliveryFeeBaseCents  Int?
  deliveryFeePerKmCents Int?
  deliveryFreeRadiusM   Int?
  deliveryMaxRadiusM    Int?
  /// Set when this row was imported from an external POS (iiko / Poster).
  /// Null for stores created natively through the admin UI.
  externalProvider      PosProvider?
  /// Provider-side identifier (iiko terminalGroupId or organization-derived
  /// id, Poster spot id). Unique within (brandId, externalProvider).
  externalId            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  brand           Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  workingHours    StoreWorkingHour[]
  stopListEntries StopListEntry[]
  carts           Cart[]
  orders          Order[]
  userStores      UserStore[]
  kdsPinUsers     User[]             @relation("KdsPinStore")

  @@unique([brandId, externalProvider, externalId])
  @@index([brandId])
  @@index([country, city])
  @@index([latitude, longitude])
}

/// Pivot table scoping a staff user to one or more stores. Used by the
/// StoreScopeGuard so STORE_MANAGER, STAFF and RIDER users only see orders
/// and dispatch queues for stores they're assigned to. Global roles
/// (BRAND_ADMIN, SUPER_ADMIN) don't need rows — the scope service treats
/// them as "all stores".
model UserStore {
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
}

model StoreWorkingHour {
  id       String  @id @default(cuid())
  storeId  String
  // 0 = Sunday, 6 = Saturday (JS getDay() convention).
  weekday  Int
  // Minutes since local midnight, e.g. 08:30 = 510.
  opensAt  Int
  closesAt Int
  isClosed Boolean @default(false)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekday])
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id               String       @id @default(cuid())
  brandId          String
  slug             String
  name             String
  description      String?
  iconUrl          String?
  sortOrder        Int          @default(0)
  // Optional availability window — minutes since local midnight.
  availableFrom    Int?
  availableTo      Int?
  visible          Boolean      @default(true)
  /// External-POS link. See {@link Store.externalProvider}.
  externalProvider PosProvider?
  externalId       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([brandId, slug])
  @@unique([brandId, externalProvider, externalId])
  @@index([brandId, sortOrder])
}

model Product {
  id               String       @id @default(cuid())
  brandId          String
  categoryId       String
  slug             String
  name             String
  description      String?
  basePriceCents   Int
  // Base preparation time in seconds; variations/modifiers add deltas.
  prepTimeSeconds  Int          @default(180)
  caffeineLevel    Int? // 0..4 cups
  calories         Int?
  proteinsGrams    Float?
  fatsGrams        Float?
  carbsGrams       Float?
  allergens        String[]     @default([])
  dietTags         DietTag[]    @default([])
  imageUrls        String[]     @default([])
  visible          Boolean      @default(true)
  sortOrder        Int          @default(0)
  // Seasonal window; null = always available.
  availableFrom    DateTime?
  availableTo      DateTime?
  /// External-POS link. See {@link Store.externalProvider}.
  externalProvider PosProvider?
  externalId       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variations      Variation[]
  modifiers       Modifier[]
  stopListEntries StopListEntry[]
  cartItems       CartItem[]

  @@unique([brandId, slug])
  @@unique([brandId, externalProvider, externalId])
  @@index([categoryId, sortOrder])
  @@index([brandId, visible])
}

model Variation {
  id                   String        @id @default(cuid())
  productId            String
  type                 VariationType
  name                 String
  priceDeltaCents      Int           @default(0)
  prepTimeDeltaSeconds Int           @default(0)
  sortOrder            Int           @default(0)
  isDefault            Boolean       @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type, sortOrder])
}

model Modifier {
  id                   String       @id @default(cuid())
  productId            String
  slug                 String
  name                 String
  priceDeltaCents      Int          @default(0)
  prepTimeDeltaSeconds Int          @default(0)
  minCount             Int          @default(0)
  maxCount             Int          @default(1)
  sortOrder            Int          @default(0)
  /// External-POS link. See {@link Store.externalProvider}. Scoped per
  /// product, not brand, because POS modifier ids are local to the parent.
  externalProvider     PosProvider?
  externalId           String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, slug])
  @@unique([productId, externalProvider, externalId])
  @@index([productId, sortOrder])
}

model StopListEntry {
  id        String    @id @default(cuid())
  storeId   String
  productId String
  reason    String?
  // Optional — when to auto-restock. Null = manual re-enable.
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cart & Order
//
// Carts are transient per (user, store). ETA is recomputed on every mutation
// based on store load + item prep times + modifier deltas.
//
// Once an order is placed, items are snapshotted into OrderItem so that
// subsequent menu/price edits do not affect placed orders.
// ─────────────────────────────────────────────────────────────────────────────

model Cart {
  id            String   @id @default(cuid())
  userId        String
  storeId       String
  subtotalCents Int      @default(0)
  etaSeconds    Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId, storeId])
  @@index([userId])
}

model CartItem {
  id              String   @id @default(cuid())
  cartId          String
  productId       String
  quantity        Int      @default(1)
  // Resolved selections captured at add time so the cart can render without
  // a round-trip to the product catalog. Refreshed on ETA/price recompute.
  variationIds    String[] @default([])
  // Map of { modifierId: count } as a small JSON blob. Avoids a join table
  // for a tiny list and keeps writes atomic.
  modifiersJson   Json     @default("{}")
  unitPriceCents  Int
  unitPrepSeconds Int
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([cartId])
}

/// Prepaid balance tied to a single brand (or to an order placed at any
/// of its stores). For v1 the purchase path is admin-driven (a brand
/// admin issues a card and shares the code out-of-band); the customer
/// types the code at checkout in the same field as a promo code, and
/// the redemption is applied as a discount.
model GiftCard {
  id                 String         @id @default(cuid())
  /// Human-typed code, normalized to uppercase A–Z0–9, no separators.
  code               String         @unique
  brandId            String
  initialAmountCents Int
  balanceCents       Int
  currency           Currency
  status             GiftCardStatus @default(ACTIVE)
  /// User who paid for the card (null when admin-issued).
  purchaserUserId    String?
  recipientEmail     String?
  recipientName      String?
  message            String?
  /// Optional expiry; null = never expires.
  expiresAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  brand        Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  purchaser    User?                 @relation("GiftCardsPurchased", fields: [purchaserUserId], references: [id], onDelete: SetNull)
  redemptions  GiftCardRedemption[]

  @@index([brandId, status])
  @@index([purchaserUserId])
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

/// One redemption row per Order that consumed gift-card balance. We
/// allow partial redemption — a customer with a $50 card can apply
/// $20 to one order and $30 to a later order.
model GiftCardRedemption {
  id          String   @id @default(cuid())
  giftCardId  String
  orderId     String   @unique
  amountCents Int
  createdAt   DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
}

model Order {
  id                  String          @id @default(cuid())
  userId              String
  storeId             String
  status              OrderStatus     @default(CREATED)
  fulfillmentType     FulfillmentType @default(PICKUP)
  pickupMode          PickupMode      @default(ASAP)
  // UTC. For ASAP it's the moment we expect to hand it over.
  pickupAt            DateTime
  subtotalCents       Int
  discountCents       Int             @default(0)
  taxCents            Int             @default(0)
  totalCents          Int
  currency            Currency
  // 4-digit human-readable code shown to the customer and barista.
  orderCode           String          @unique
  // Opaque token embedded in the pickup QR; independent of the short code.
  qrToken             String          @unique
  paymentIntentId     String?
  /// Seconds the customer waits once the kitchen starts on their order —
  /// the longest single item, because a barista pulls a shot while the milk
  /// steams. Snapshotted at creation so a later menu edit cannot rewrite it.
  prepSeconds         Int             @default(0)
  /// Seconds of kitchen time this order consumes, summed across items. This
  /// is what loads the queue for everyone behind it, and it is deliberately
  /// a different number from prepSeconds.
  workSeconds         Int             @default(0)
  customerName        String?
  customerPhone       String?
  notes               String?
  couponCode          String?
  /// Gift-card code typed at checkout (normalized). Mirrored here so we
  /// keep the original code alongside the redemption row even if the
  /// gift card is later cancelled.
  giftCardCode        String?
  giftCardCents       Int             @default(0)
  /// Loyalty points the customer burned on this order, and what they were
  /// worth. Kept separate from `discountCents` so a receipt can say
  /// "you spent 250 points" rather than just showing a smaller number.
  pointsSpent         Int             @default(0)
  pointsDiscountCents Int             @default(0)
  // Delivery-only fields. Mirror of address/fee kept on the Order so history
  // is immutable even if the customer's default address changes later. All
  // nullable because the PICKUP / DINE_IN path doesn't fill them.
  deliveryAddressLine String?
  deliveryCity        String?
  deliveryLatitude    Float?
  deliveryLongitude   Float?
  deliveryNotes       String?
  deliveryFeeCents    Int             @default(0)
  /// Estimated distance from store to delivery address (metres). Optional —
  /// geocoding/distance estimation is a follow-up, stored here when available.
  deliveryDistanceM   Int?
  riderId             String?
  /// Identifier of the corresponding order in the external POS (iiko orderId
  /// or Poster transactionId), set after a successful ORDER_PUSH job.
  posExternalId       String?
  // Status timeline — denormalized from OrderEvent for quick queries.
  createdAt           DateTime        @default(now())
  acceptedAt          DateTime?
  startedAt           DateTime?
  readyAt             DateTime?
  pickedUpAt          DateTime?
  outForDeliveryAt    DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  expiredAt           DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  rider           User?            @relation("RiderDeliveries", fields: [riderId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  events          OrderEvent[]
  payments         Payment[]
  pointsEntries    PointsLedger[]
  promoRedemption  PromoRedemption?
  giftCardRedemption GiftCardRedemption?

  @@index([userId, createdAt])
  @@index([storeId, status])
  @@index([status, pickupAt])
  @@index([riderId, status])
  // Slot occupancy counts scan one store's handovers inside a 15-minute
  // window, on every checkout render.
  @@index([storeId, pickupAt])
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  // Full product/variations/modifiers snapshot at the moment of order
  // creation so price/stock edits do not mutate history.
  productSnapshot Json
  quantity        Int
  unitPriceCents  Int
  totalCents      Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  type      OrderEventType
  actorId   String?
  payload   Json?
  createdAt DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  provider      PaymentProvider @default(STRIPE)
  providerRef   String? // Stripe PaymentIntent id, Telegram charge id, etc.
  status        PaymentStatus   @default(PENDING)
  amountCents   Int
  refundedCents Int             @default(0)
  currency      Currency
  rawJson       Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerRef])
}

// ─────────────────────────────────────────────────────────────────────────────
// Loyalty
// ─────────────────────────────────────────────────────────────────────────────

/// One row per user. Denormalized balance + current tier updated inside the
/// same transaction as ledger writes so reads stay cheap.
model LoyaltyAccount {
  id             String      @id @default(cuid())
  userId         String      @unique
  pointsBalance  Int         @default(0)
  lifetimePoints Int         @default(0)
  tier           LoyaltyTier @default(SILVER)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries PointsLedger[]

  @@index([tier])
}

/// Append-only ledger — any change to LoyaltyAccount.pointsBalance must have a
/// matching row here so we can audit / reverse / show "Recent activity".
model PointsLedger {
  id               String          @id @default(cuid())
  loyaltyAccountId String
  userId           String
  orderId          String?
  type             PointsEntryType
  // Positive for EARN/ADJUST credits, negative for SPEND/EXPIRE/ADJUST debits.
  amount           Int
  reason           String
  metadata         Json?
  createdAt        DateTime        @default(now())

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Promo
// ─────────────────────────────────────────────────────────────────────────────

/// A coupon/loyalty promotion owned by a brand. Validated at checkout and
/// snapshotted onto the order so subsequent edits to the promo never rewrite
/// history.
model Promo {
  id               String      @id @default(cuid())
  brandId          String
  /// Public code the customer types. Case-insensitive unique within brand.
  code             String
  label            String
  type             PromoType
  /// For PERCENT — integer 1..100.
  /// For FIXED   — discount in cents.
  /// For BOGO    — 1 (reserved for future trigger counts).
  /// For POINTS_MULTIPLIER — multiplier ×10 (so "2.5x" = 25).
  value            Int
  /// Optional minimum cart subtotal (cents).
  minSubtotalCents Int?
  /// 0 = unlimited.
  maxRedemptions   Int         @default(0)
  perUserLimit     Int         @default(0)
  startsAt         DateTime
  endsAt           DateTime
  status           PromoStatus @default(DRAFT)
  currency         Currency    @default(USD)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  brand       Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  redemptions PromoRedemption[]

  @@unique([brandId, code])
  @@index([brandId, status])
  @@index([startsAt, endsAt])
}

model PromoRedemption {
  id            String   @id @default(cuid())
  promoId       String
  userId        String
  orderId       String   @unique
  discountCents Int
  createdAt     DateTime @default(now())

  promo Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([promoId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// POS integrations
//
// One Brand may attach multiple providers in principle (one row per provider),
// although in practice a brand operates on a single back-office. Credentials
// are stored as opaque AES-256-GCM ciphertext — never plain — and the cipher
// is keyed off env POS_CREDENTIALS_KEY. The plain-shape of credentials is
// provider-specific and lives in the IPosProvider layer; the DB doesn't care.
// ─────────────────────────────────────────────────────────────────────────────

model PosIntegration {
  id                    String               @id @default(cuid())
  brandId               String
  provider              PosProvider
  /// AES-256-GCM ciphertext: base64(iv || authTag || cipher). Decrypted only
  /// in IPosProvider implementations through SecretCipher.
  credentialsCiphertext String
  status                PosIntegrationStatus @default(DISCONNECTED)
  /// Provider-specific non-secret config (iiko organizationId, Poster
  /// account name, polling cadence overrides, etc.). Schema is enforced in
  /// the provider layer, not in the DB.
  settings              Json                 @default("{}")
  lastSyncAt            DateTime?
  lastErrorMessage      String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  brand Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  jobs  PosSyncJob[]

  @@unique([brandId, provider])
  @@index([brandId])
  @@index([status])
}

/// One row per scheduled / running / finished sync attempt against a
/// {@link PosIntegration}. The same row is updated as the BullMQ worker
/// progresses so the admin UI can poll or subscribe over WS.
model PosSyncJob {
  id            String           @id @default(cuid())
  integrationId String
  kind          PosSyncJobKind
  status        PosSyncJobStatus @default(PENDING)
  /// 0..total. Kept in sync with BullMQ job progress as the worker runs.
  progress      Int              @default(0)
  total         Int              @default(0)
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime         @default(now())

  integration PosIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@index([integrationId, kind, createdAt])
  @@index([status])
}
