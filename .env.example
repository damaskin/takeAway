# ──────────────────────────────────────────────────────────────
# takeAway — local development environment variables
# Copy this file to .env and fill in real values for your machine.
# Never commit .env to git.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development

# API
API_PORT=3000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api

# Database (matches infra/docker-compose.yml — host port 55432 to avoid
# clashing with a native Postgres install on 5432)
DATABASE_URL=postgresql://takeaway:takeaway@localhost:55432/takeaway?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-in-prod-access
JWT_REFRESH_SECRET=change-me-in-prod-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# S3 / MinIO / DigitalOcean Spaces / any S3-compatible storage.
# S3_PUBLIC_URL_BASE is optional — set when your bucket is served from a
# custom domain or CDN (e.g. https://cdn.takeaway.md).
# If omitted and S3_ENDPOINT is set, defaults to ${S3_ENDPOINT}/${S3_BUCKET};
# otherwise to https://${S3_BUCKET}.s3.${S3_REGION}.amazonaws.com.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=takeaway-dev
S3_PUBLIC_URL_BASE=

# Mail (Mailhog in dev, SMTP_SECURE=false since Mailhog is plain TCP).
# For Brevo/Resend/SES in prod, point SMTP_HOST at their relay and set
# SMTP_USER/SMTP_PASS + SMTP_SECURE=true (port 465) or false (587).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@takeaway.local

# ── Hardening ────────────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser, comma-separated. Empty
# reflects whatever origin asks, which is fine locally (four SPAs on four
# ports) and unacceptable in production — any page anywhere could then call
# this API in a signed-in browser's name.
#   CORS_ALLOWED_ORIGINS=https://takeaway.md,https://admin.takeaway.md
CORS_ALLOWED_ORIGINS=

# Swagger is always on outside production. It maps every endpoint, DTO and
# auth requirement, so production has to opt in rather than opt out.
SWAGGER_ENABLED=false

# Passphrase for the nightly database backup. The dump carries names,
# emails, phones and order history, and it is mirrored into a git repo whose
# history keeps everything forever — so it is encrypted before it leaves the
# box, and destroying this key renders every copy unreadable (which is how
# an erasure request is honoured against immutable backups).
# Generate with: openssl rand -base64 48
# The backup script refuses to run without it.
BACKUP_ENCRYPTION_KEY=

# 3rd-party (leave empty in local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MAPBOX_TOKEN=
MIXPANEL_TOKEN=
SENTRY_DSN=
# Fraction of transactions traced, 0..1. Errors are always reported; traces
# are billed per span and off by default.
SENTRY_TRACES_SAMPLE_RATE=0
TELEGRAM_BOT_TOKEN=

# ── Ops alerting ─────────────────────────────────────────────────────────────
# Telegram chat that receives operational alerts: a dependency down, paid
# orders the kitchen has not accepted, a stalled analytics roll-up — and a
# ping for every brand that signs up or is resubmitted for review. Uses
# TELEGRAM_BOT_TOKEN above. Empty disables alerting entirely — no chat, no
# messages, no cost. Get the id by adding the bot to the chat and reading
# https://api.telegram.org/bot<TOKEN>/getUpdates.
OPS_ALERT_TELEGRAM_CHAT_ID=

# Web Push API (VAPID). Generate with `npx web-push generate-vapid-keys`.
# Subject is shown to the browser's push service — typically a mailto:.
# Leave empty to disable browser push (the WebPushProvider becomes a no-op).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@takeaway.local

# How long an order may sit unpaid before it is released, in minutes.
# On expiry the promo redemption, the gift-card balance and the pickup slot
# all go back. Default 15; values below 5 are clamped so a typo cannot
# expire orders the moment they are placed.
ORDER_PAYMENT_TTL_MINUTES=15

# A paid-for order (amount held on the card) waits this long for the kitchen
# to accept it before it expires and the hold is released. A scheduled order
# is kept at least until its pickup time plus ORDER_ACCEPT_GRACE_MINUTES.
# Defaults 30 and 15; values below 5 are clamped.
ORDER_ACCEPT_TTL_MINUTES=30
ORDER_ACCEPT_GRACE_MINUTES=15

# Loyalty points awarded to BOTH sides of a referral when the referee's
# first paid order lands. Defaults to 100. Set to 0 to soft-disable the
# program without removing the UI.
REFERRAL_BONUS_POINTS=100

# Telegram Login Widget bot username (without @). Read at build time by the
# web SPA; public value — token stays in TELEGRAM_BOT_TOKEN.
TELEGRAM_BOT_USERNAME=

# Telegram Login (OpenID Connect) — the website, the admin and the mobile apps.
# The client id is the bot's numeric id; empty means the id in
# TELEGRAM_BOT_TOKEN. Production runs @takaway_tgbot (8550171231), switched to
# OpenID Connect in @BotFather — deploy/.env.production.example lists what is
# registered there. A bot used locally needs the same setup of its own:
# Telegram answers "redirect_uri required" to any redirect URI the bot does
# not list (the mobile app sends takeaway://tglogin). The web and admin dev
# servers keep the legacy widget: their index.html declares an empty
# __TELEGRAM_CLIENT_ID.
TELEGRAM_LOGIN_CLIENT_ID=

# ── Social sign-in (customers) ───────────────────────────────────────────────
# Comma-separated list of OAuth client ids we accept as the `aud` claim on an
# incoming ID token. One entry per platform, because Google and Apple mint a
# different client id for each:
#   GOOGLE_OAUTH_CLIENT_IDS=<web>.apps.googleusercontent.com,<ios>.apps.googleusercontent.com
#   APPLE_OAUTH_CLIENT_IDS=com.takeaway.web,com.takeaway.app
# Apple's web entry is the Services ID; the native one is the app bundle id.
# Leave empty to disable that provider — the endpoint then returns 401 and the
# SPA hides the button (client ids are public and set per-SPA in index.html).
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=

# Sign in with Apple token revocation on account deletion (App Store guideline
# 5.1.1(v)). The iOS app sends a fresh authorization code with DELETE
# /auth/me; the API exchanges it at Apple and revokes the tokens. Needs a
# Sign in with Apple key (developer.apple.com → Keys): team id, key id and
# the .p8 contents as one line with literal \n. Empty skips revocation with a
# warning — the account is still deleted. The client id defaults to the first
# APPLE_OAUTH_CLIENT_IDS entry that is not APPLE_OAUTH_SERVICES_ID (the iOS
# bundle id); APPLE_REVOKE_CLIENT_ID overrides it.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REVOKE_CLIENT_ID=

# iOS push straight through Apple (APNs, token-based). The iOS app registers
# its raw APNs token next to the FCM one; with a key here iPhones are pushed
# directly instead of through the APNs key uploaded to Firebase. A key from
# developer.apple.com → Keys with "Apple Push Notifications service" enabled,
# the .p8 contents on one line with literal \n. When APNS_PRIVATE_KEY is
# empty the APPLE_* key above is used (it needs APNs enabled too); with
# neither, iOS goes through FCM only. APNS_TOPIC is the iOS bundle id.
# APNS_ENABLED=false turns direct pushes off.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=md.takeaway.ios
APNS_ENABLED=

# Base URL of the admin app. Used in password-reset and brand-moderation
# email links so the recipient lands on the right host.
ADMIN_APP_URL=http://localhost:4202

# Language of the emails to the platform team (every SUPER_ADMIN): a new
# brand to review, a brand resubmitted after changes. `ru` or `en`; Russian
# when unset. Brand owners get theirs in the brand's own language.
PLATFORM_LOCALE=ru

# Where business owners reach the platform team — shown next to a
# moderation verdict in the admin and in the "changes needed" email.
# Public (served by GET /config/features). Telegram takes a username, an
# @handle or a t.me link. Leave both empty to show no contact.
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=

# First super-admin bootstrap. Seed script reads these once to create the
# user if no SUPER_ADMIN exists yet. Leave empty in dev if you've already
# seeded a super-admin.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Master switch for the M6 delivery module. Off by default — flip to `true`
# when ops is ready to launch delivery (enables dispatcher + rider UI + lets
# customers pick DELIVERY on checkout).
DELIVERY_ENABLED=false

# ── POS integrations (iiko / Poster) ─────────────────────────────────────────
# 32-byte symmetric key, hex-encoded (so 64 hex chars). Used by SecretCipher
# to AES-256-GCM encrypt POS credentials at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotate by re-encrypting all PosIntegration rows with the new key — there
# is no graceful key-rotation path baked in.
POS_CREDENTIALS_KEY=

# Poster app catalog credentials. Application Id + Secret from
# https://joinposter.com developer dashboard. Required to:
#   - verify the `verify` field on incoming webhooks
#     (verify = md5(account_number + access_token + APPLICATION_SECRET))
#   - exchange OAuth `code` for an access_token when a Poster account
#     connects via our entry in the Poster app catalog.
# Empty → app webhook handler accepts unsigned events with a warning.
POSTER_APPLICATION_ID=
POSTER_APPLICATION_SECRET=

# ── Agroprombank («Клевер») card payments ────────────────────────────────────
# Tokenized card payments for Transnistria. See docs/agroprombank-payments.md
# for the full setup, including how to obtain the merchant certificate.
#
# Off by default. The API refuses every /payments/agroprombank route and the
# clients hide card binding until this is `true`.
AGROPROMBANK_ENABLED=false

# Issued by the bank when the merchant contract is signed.
AGROPROMBANK_MERCHANT_ID=
AGROPROMBANK_TERMINAL_ID=

# SOAP endpoint and target namespace. Defaults match MerchantCAPService.asmx —
# only set these if the bank moves the service.
# AGROPROMBANK_ENDPOINT=https://ws.agroprombank.com/merchant/MerchantCAPService.asmx
# AGROPROMBANK_NAMESPACE=http://services.agroprombank.com

# Merchant signing key + certificate, generated with the CA software at
# https://ca.agroprombank.com (certificate purpose: «Пластиковые карты» →
# «Система E-Commerce» → «Сертификат E-Commerce терминала»).
# Either inline PEM (literal \n is unescaped) or a path via the _FILE variant.
AGROPROMBANK_PRIVATE_KEY=
AGROPROMBANK_PRIVATE_KEY_FILE=
AGROPROMBANK_CERTIFICATE=
AGROPROMBANK_CERTIFICATE_FILE=

# Bank certificate used to verify the signature on every response. Without it
# only TLS stands between us and a forged "payment succeeded", so the service
# refuses to run unless verification is explicitly switched off.
AGROPROMBANK_BANK_CERTIFICATE=
AGROPROMBANK_BANK_CERTIFICATE_FILE=
# Set to `false` ONLY during the integration window, before the bank hands
# over its certificate.
AGROPROMBANK_VERIFY_RESPONSES=true

# Embed <KeyInfo> with our certificate in each request. The documented samples
# omit it, but the production gateway refuses a request without it («Ошибка
# проверки подписи»), so this defaults to on and AGROPROMBANK_CERTIFICATE is
# required. Turn it off only if the bank changes its mind.
AGROPROMBANK_INCLUDE_KEYINFO=true

# `invoiceid` must stay unique for the life of the merchant contract, so give
# every environment its own prefix — DIGITS ONLY: the bank reads invoiceid as a
# number and fails a charge with a letter in it ("Input string was not in a
# correct format."). Production uses 1; pick another digit for staging.
AGROPROMBANK_INVOICE_PREFIX=

# Hold the money at checkout and take it only when the store accepts the order
# (ProcessCardAutoPayment preauth + CompletePreAuthorizaion). On by default so
# nobody is out of pocket for an order that never gets taken on. Set to false
# for a merchant whose acquiring contract has no preauthorization.
AGROPROMBANK_HOLD_UNTIL_ACCEPTED=true

# One-time password window and attempt budget for card binding.
AGROPROMBANK_BINDING_TTL_MINUTES=10
AGROPROMBANK_BINDING_MAX_ATTEMPTS=3

# Request timeout in ms, and the `istest` flag echoed to the bank.
AGROPROMBANK_TIMEOUT_MS=30000
AGROPROMBANK_IS_TEST=false

# ── Agroprombank «Web-платёж» (the bank's hosted payment page) ───────────────
# A second card flow: the customer types the card on the bank's page; the
# amount is held (ispreauth=1) and taken when the kitchen accepts the order.
# Separate registration at the bank — see docs/agroprombank-payments.md,
# «Web-платёж». Off by default.
AGROPROMBANK_WEB_ENABLED=false
# Which checkout the clients run: token (bound card, default) or web (the
# bank's page). `web` takes effect only with AGROPROMBANK_WEB_ENABLED=true.
CARD_PAYMENT_FLOW=token
# Issued by the bank at registration. MERCHANT_ID (admin web service) defaults
# to the login. The pass signs every request and callback (MD5) — a secret.
AGROPROMBANK_WEB_MERCHANT_LOGIN=
AGROPROMBANK_WEB_MERCHANT_ID=
AGROPROMBANK_WEB_MERCHANT_PASS=
AGROPROMBANK_WEB_MERCHANT_PASS_FILE=
# Defaults: the bank's page and its admin web service. The namespace is the
# SOAPAction prefix — to be confirmed against the bank's WSDL.
# AGROPROMBANK_WEB_PAYMENT_URL=https://epay.apb.online/PaymentStart
# AGROPROMBANK_WEB_SERVICE_URL=https://ws.agroprombank.com/merchant/APB.SV.WebPayment.AgentService.asmx
# AGROPROMBANK_WEB_NAMESPACE=http://services.agroprombank.com
# IsTest=1 on the page: nothing is charged.
AGROPROMBANK_WEB_IS_TEST=false
# Invoice lifetime on the bank's page, minutes. Keep it at or below
# ORDER_PAYMENT_TTL_MINUTES.
AGROPROMBANK_WEB_LIFETIME_MINUTES=15
# true: hold at checkout, take on accept. false: charge at checkout.
AGROPROMBANK_WEB_HOLD_UNTIL_ACCEPTED=true
# The bank signs admin web-service answers with its site certificate (PEM).
# Without it the API refuses Web-платёж unless verification is switched off,
# which leaves only TLS against a forged "paid" and logs a warning per call.
AGROPROMBANK_WEB_BANK_CERT=
AGROPROMBANK_WEB_BANK_CERT_FILE=
AGROPROMBANK_WEB_VERIFY_RESPONSES=true
AGROPROMBANK_WEB_TIMEOUT_MS=20000
# Where the customer lands after the bank's page: <PUBLIC_WEB_URL>/orders/:id,
# <PUBLIC_TMA_URL>/orders/:id (or, for a t.me/<bot>/<app> link,
# ?startapp=order_<id>), and the app's deep link <MOBILE_PAYMENT_RETURN_URL>?orderId=…
PUBLIC_WEB_URL=http://localhost:4200
PUBLIC_TMA_URL=http://localhost:4201
MOBILE_PAYMENT_RETURN_URL=takeaway://pay
